# Environment Variables Configuration
# Copy this file to .env and fill in the actual values

# Brevo API Key (required)
BREVO_API_KEY=your_brevo_api_key_here

# Admin email to receive contact form submissions (required)
ADMIN_EMAIL=antonio@punctoapp.com

# Sender email for outgoing emails (must be verified in Brevo) (required)
SENDER_EMAIL=customers@punctoapp.com

# Allowed origin for CORS in production (required for production)
ALLOWED_ORIGIN=https://punctoapp.com

# Node environment (development or production)
NODE_ENV=development

# Shared secret required in the x-relay-key header on /api/send (required
# for that endpoint only — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RELAY_API_KEY=your_relay_secret_here